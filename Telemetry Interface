    # try:
    #     ser = serial.Serial(COM_PORT, BAUD_RATE, timeout=1)
    #     linea = ser.readline().decode('utf-8').strip()
    #     partes = linea.split(',')
    #     temp_int    = float(partes[0])
    #     temp_volcan = float(partes[1])
    #     bateria     = float(partes[2])
    #     latencia    = float(partes[3])
    #     ser.close()
    #
    #     historial_temp.append(temp_volcan)
    #     historial_tiempo.append(historial_tiempo[-1] + 1)
    #
    #     return {
    #         'temp_volcan':   temp_volcan,
    #         'temp_interna':  temp_int,
    #         'bateria_pct':   bateria,
    #         'latencia':      latencia,
    #         'thermal_map':   np.zeros((24, 32)),  # si envías la matriz, parsearla aquí
    #         'historial_temp':  list(historial_temp),
    #         'historial_tiempo': list(historial_tiempo),
    #         'rssi':          -82.0,
    #         'paquetes_tx':   0,
    #         'cpu_pct':       0,
    #     }
