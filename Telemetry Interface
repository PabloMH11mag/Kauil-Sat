# Intervalo de actualización en milisegundos
INTERVALO_MS = 2000

# Historial de temperatura (ventana de 60 puntos = 2 min a 2s/punto)
HISTORIAL_MAX = 60

# Buffer circular de temperatura volcánica
historial_temp = collections.deque(
    [220 + i * 0.45 for i in range(HISTORIAL_MAX)],
    maxlen=HISTORIAL_MAX
)
historial_tiempo = collections.deque(
    list(range(-HISTORIAL_MAX + 1, 1)),
    maxlen=HISTORIAL_MAX
)


# ── 2. FUENTE DE DATOS ────────────────────────────────────────────────────────
# Esta función es el único lugar que necesitas modificar para cambiar
# de datos simulados a datos reales del nRF24L01.

def get_sensor_data():
    """
    Devuelve un diccionario con las lecturas actuales del sistema.

    MODO SIMULADO (activo ahora):
        Genera datos aleatorios que imitan el comportamiento real.

    MODO HARDWARE REAL (descomentar para usar con ESP32 + nRF24L01):
        Lee una línea del puerto serial con formato:
        TEMP_INT,TEMP_VOLCAN,BATERIA_PCT,LATENCIA
        Ejemplo:  38.5,247.3,74.2,0.41
    """

    # ── SIMULACIÓN ────────────────────────────────────────────────────────
    ultima_temp = historial_temp[-1]
    nueva_temp  = ultima_temp + random.uniform(-0.5, 1.2)   # tendencia ascendente
    nueva_temp  = max(215, min(270, nueva_temp))             # límites físicos

    historial_temp.append(nueva_temp)
    historial_tiempo.append(historial_tiempo[-1] + 1)

    # Mapa térmico simulado: zona caliente en el centro (cráter volcánico)
    thermal = np.random.uniform(60, 120, (24, 32))
    thermal[8:14, 12:20] = np.random.uniform(nueva_temp * 0.85, nueva_temp, (6, 8))
    thermal[6:16, 10:22] = np.maximum(
        thermal[6:16, 10:22],
        np.random.uniform(nueva_temp * 0.6, nueva_temp * 0.8, (10, 12))
    )
    thermal = gaussian_filter(thermal, sigma=1.5)

    return {
        'temp_volcan':   round(nueva_temp, 1),
        'temp_interna':  round(random.uniform(36.5, 40.5), 1),
        'bateria_pct':   round(max(60, 74 - (time.time() % 3600) / 3600 * 5), 1),
        'latencia':      round(random.uniform(0.28, 0.65), 2),
        'thermal_map':   thermal,
        'historial_temp': list(historial_temp),
        'historial_tiempo': list(historial_tiempo),
        'rssi':          round(random.uniform(-88, -76), 1),
        'paquetes_tx':   int(time.time()) % 9999,
        'cpu_pct':       random.randint(22, 45),
    }

    # ── HARDWARE REAL (descomentar las líneas de abajo) ───────────────────
    # import serial
    # COM_PORT = '/dev/ttyUSB0'   # Linux/Mac  →  cambiar según tu sistema
    # COM_PORT = 'COM3'           # Windows    →  cambiar según tu puerto
    # BAUD_RATE = 115200
