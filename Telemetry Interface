def estilo_metrica(label, valor, unidad, color, delta_texto):
    """Genera el contenido de una tarjeta de métrica."""
    return [
        html.P(label, style={'fontSize': '10px', 'color': MUTED, 'margin': '0 0 4px 0'}),
        html.P([
            html.Span(valor, style={'fontSize': '22px', 'fontWeight': 'bold', 'color': color}),
            html.Span(f' {unidad}', style={'fontSize': '11px', 'color': MUTED}),
        ], style={'margin': '0'}),
        html.P(delta_texto, style={'fontSize': '10px', 'color': color, 'margin': '4px 0 0 0'}),
    ]


def grafica_base():
    """Config base compartida por todas las gráficas."""
    return dict(
        paper_bgcolor=PANEL, plot_bgcolor=PANEL,
        margin=dict(l=40, r=10, t=10, b=30),
        font=dict(family='Consolas, monospace', color=MUTED, size=10),
        xaxis=dict(gridcolor=BORDER, zeroline=False),
        yaxis=dict(gridcolor=BORDER, zeroline=False),
    )


@callback(
    # Todos los IDs que se actualizan en cada tick
    Output('reloj',               'children'),
    Output('modo-badge',          'children'),
    Output('modo-badge',          'style'),
    Output('card-temp-volcan',    'children'),
    Output('card-temp-volcan',    'style'),
    Output('card-temp-int',       'children'),
    Output('card-bateria',        'children'),
    Output('card-latencia',       'children'),
    Output('grafica-temp',        'figure'),
    Output('mapa-termico',        'figure'),
    Output('grafica-subsistemas', 'figure'),
    Output('grafica-potencia',    'figure'),
    Output('balance-energetico',  'children'),
    Output('panel-alertas',       'children'),
    Output('log-telemetria',      'children'),
    Output('link-status',         'children'),
    Input('intervalo',            'n_intervals'),
)
def actualizar_todo(n):
    datos = get_sensor_data()
    if datos is None:
        return ['Error de conexión'] + [None] * 15

    tv   = datos['temp_volcan']
    ti   = datos['temp_interna']
    bat  = datos['bateria_pct']
    lat  = datos['latencia']
    rssi = datos['rssi']
    cpu  = datos['cpu_pct']
    hist = datos['historial_temp']
    hist_t = datos['historial_tiempo']
    thermal = datos['thermal_map']

    ahora = datetime.now(timezone.utc).strftime('%H:%M:%S UTC')
    alerta_activa = tv > TEMP_UMBRAL

    # ── Reloj + badge de modo ──────────────────────────────────────────────
    if alerta_activa:
        modo_txt   = '⚠ ALERTA CRÍTICA'
        modo_style = {'fontSize': '11px', 'padding': '3px 12px', 'borderRadius': '20px',
                      'fontWeight': 'bold', 'backgroundColor': '#3D0A0A', 'color': RED,
                      'border': f'1px solid {RED}'}
    else:
        modo_txt   = '● OBSERVATION'
        modo_style = {'fontSize': '11px', 'padding': '3px 12px', 'borderRadius': '20px',
                      'fontWeight': 'bold', 'backgroundColor': '#0D2A14', 'color': GREEN,
                      'border': f'1px solid {GREEN}'}

    # ── Tarjetas de métricas ───────────────────────────────────────────────
    color_tv = RED if alerta_activa else AMBER
    delta_tv = f'+{tv - hist[-2]:.1f}°C desde última lectura' if len(hist) > 1 else ''
    card_tv  = estilo_metrica('TEMP. VOLCÁN (MLX90640)', f'{tv}', '°C', color_tv, delta_tv)
    borde_tv = {'backgroundColor': PANEL, 'borderRadius': '8px', 'padding': '12px 16px',
                'border': f'2px solid {RED}' if alerta_activa else f'1px solid {BORDER}'}

    card_ti  = estilo_metrica('TEMP. INTERNA (LM35)', f'{ti}', '°C', GREEN, 'nominal')
    card_bat = estilo_metrica('BATERÍA 3S (Li-ion)', f'{bat}', '%',
                              GREEN if bat > 50 else AMBER, f'{11.1 - (74 - bat) * 0.02:.2f} V')
    card_lat = estilo_metrica('LATENCIA TLC', f'{lat}', 's',
                              GREEN if lat < 1 else RED, 'req. < 1 s ✓' if lat < 1 else 'req. < 1 s ✗')

    # ── Gráfica de gradiente térmico ──────────────────────────────────────
    fig_temp = go.Figure()
    fig_temp.add_trace(go.Scatter(
        x=list(hist_t), y=hist,
        fill='tozeroy', fillcolor='rgba(239,68,68,0.08)',
        line=dict(color=RED, width=1.5),
        mode='lines', name='Temp. volcán',
    ))
    fig_temp.add_hline(y=TEMP_UMBRAL, line=dict(color=AMBER, width=1, dash='dash'))
    fig_temp.add_annotation(
        x=hist_t[2], y=TEMP_UMBRAL + 2,
        text=f'umbral crítico {TEMP_UMBRAL}°C',
        showarrow=False, font=dict(size=9, color=AMBER),
    )
    # Configuración para Temperatura
    conf_temp = grafica_base()
    conf_temp.update(
        yaxis=dict(
            range=[200, 275], 
            gridcolor=BORDER, 
            zeroline=False,
            ticksuffix='°C', 
            tickfont=dict(size=9)
        ),
        xaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            ticksuffix='s', 
            tickfont=dict(size=9)
        ),
        showlegend=False
    )
    fig_temp.update_layout(**conf_temp)

    # ── Mapa térmico (heatmap) ─────────────────────────────────────────────
    fig_mapa = go.Figure(go.Heatmap(
        z=thermal, colorscale='Inferno',
        zmin=60, zmax=270,
        colorbar=dict(
            thickness=10, tickfont=dict(size=9, color=MUTED),
            title=dict(text='°C', font=dict(size=9, color=MUTED)),
            tickcolor=MUTED,
        ),
        hoverongaps=False,
    ))
    # Configuración para el Mapa / Trayectoria
    conf_mapa = grafica_base()
    conf_mapa.update(
        yaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9)
        ),
        xaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9)
        ),
        showlegend=False
    )
    fig_mapa.update_layout(**conf_mapa)

    # ── Barras de subsistemas ──────────────────────────────────────────────
    subs  = ['PL sensor', 'ELEC', 'TLC (RF)', 'PW bat.', 'SW CPU', 'EST']
    vals  = [95, 100, min(100, max(0, 100 + rssi + 82)), bat, cpu, 55]
    cols  = [GREEN, GREEN, GREEN if vals[2] > 60 else AMBER, GREEN, GREEN, GREEN]

    fig_sub = go.Figure(go.Bar(
        x=vals, y=subs, orientation='h',
        marker=dict(color=cols, opacity=0.85),
        text=[f'{v:.0f}%' for v in vals],
        textposition='outside',
        textfont=dict(size=9, color=MUTED),
        width=0.55,
    ))
    # Configuración para Subida / Gráfica Secundaria
    conf_sub = grafica_base()
    conf_sub.update(
        xaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9)
        ),
        yaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9)
        ),
        showlegend=False
    )
    fig_sub.update_layout(**conf_sub)

    # ── Barras de consumo de potencia ──────────────────────────────────────
    comps  = ['ESP32', 'MLX90640', 'LoRa', 'LM35', 'Mini360']
    powers = [52, 7.6, 20, 0.3, 25]
    p_cols = [ACCENT, TEAL, '#D85A30', GREEN, AMBER]

    fig_pow = go.Figure(go.Bar(
        x=comps, y=powers,
        marker=dict(color=p_cols, opacity=0.85),
        text=[f'{p}' for p in powers],
        textposition='outside',
        textfont=dict(size=9, color=MUTED),
        width=0.6,
    ))
    # Configuración para Potencia / Batería
    conf_pow = grafica_base()
    conf_pow.update(
        yaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9),
            ticksuffix='V'  # Asumiendo que mides Voltaje
        ),
        xaxis=dict(
            gridcolor=BORDER, 
            zeroline=False, 
            tickfont=dict(size=9),
            ticksuffix='s'
        ),
        showlegend=False
    )
    fig_pow.update_layout(**conf_pow)

    # ── Balance energético ────────────────────────────────────────────────
    autonomia = round((bat / 100) * 2.9, 1)
    balance = html.Div(style={'fontSize': '11px'}, children=[
        fila_balance('Consumo diario',  '9.5 Wh',   WHITE),
        fila_balance('Capacidad 3S',    '27.7 Wh',  GREEN),
        fila_balance('Panel solar',     '5 W',       ACCENT),
        fila_balance('Autonomía s/sol', f'{autonomia} días', AMBER),
        fila_balance('RSSI enlace',     f'{rssi} dBm',
                     GREEN if rssi > -85 else RED),
        fila_balance('Paquetes TX',     f'#{datos["paquetes_tx"]:04d}', MUTED),
    ])

    # ── Panel de alertas ──────────────────────────────────────────────────
    def alerta(nivel, titulo, desc, color, bg_color):
        return html.Div(style={
            'backgroundColor': bg_color, 'borderRadius': '6px',
            'border': f'1px solid {color}', 'padding': '9px 14px',
            'marginBottom': '6px', 'display': 'flex', 'gap': '10px',
        }, children=[
            html.Span(nivel, style={
                'fontSize': '10px', 'fontWeight': 'bold', 'color': color,
                'backgroundColor': color + '22', 'padding': '2px 8px',
                'borderRadius': '4px', 'flexShrink': '0', 'alignSelf': 'flex-start',
            }),
            html.Div([
                html.P(titulo, style={'fontSize': '11px', 'fontWeight': 'bold',
                                      'color': color, 'margin': '0 0 2px 0'}),
                html.P(desc,   style={'fontSize': '10px', 'color': MUTED, 'margin': '0'}),
            ]),
        ])

    alertas_list = [
        html.P('PANEL DE ALERTAS', style={
            'fontSize': '10px', 'color': MUTED, 'letterSpacing': '0.5px',
            'margin': '0 0 8px 0',
        }),
    ]
    if alerta_activa:
        alertas_list.append(alerta(
            '⚠ CRÍTICO',
            f'Anomalía térmica detectada — posible actividad volcánica',
            f'MLX90640: {tv}°C (+{tv-TEMP_UMBRAL:.1f}°C sobre umbral). '
            f'Umbral crítico {TEMP_UMBRAL}°C superado. Transmisión prioritaria activada.',
            RED, '#1A0505',
        ))
    else:
        alertas_list.append(alerta(
            '✓ NOMINAL',
            f'Temperatura dentro de parámetros normales',
            f'MLX90640: {tv}°C — por debajo del umbral crítico de {TEMP_UMBRAL}°C.',
            GREEN, '#051A0A',
        ))

    alertas_list.append(alerta(
        '⚠ WARN' if rssi < -85 else '✓ OK',
        'Señal RF — nRF24L01',
        f'RSSI: {rssi} dBm. Margen: {rssi + 94:.0f} dB sobre sensibilidad mínima.',
        AMBER if rssi < -85 else GREEN,
        '#1A1205' if rssi < -85 else '#051A0A',
    ))
    alertas_list.append(alerta(
        '✓ OK', 'Balance energético positivo',
        f'Paneles solares: 5 W generados. Consumo: ~105 mW. Batería: {bat}%.',
        GREEN, '#051A0A',
    ))

    panel_alertas = html.Div(style={
        'backgroundColor': PANEL, 'borderRadius': '8px',
        'border': f'2px solid {RED}' if alerta_activa else f'1px solid {BORDER}',
        'padding': '12px',
    }, children=alertas_list)

    # ── Log de telemetría ──────────────────────────────────────────────────
    def fila_log(tiempo, tag, msg, tag_color):
        return html.Div(style={
            'display': 'flex', 'gap': '12px', 'alignItems': 'center',
            'padding': '4px 0', 'borderBottom': f'1px solid {BORDER}',
            'fontSize': '10px',
        }, children=[
            html.Span(tiempo, style={'color': MUTED, 'width': '60px', 'flexShrink': '0'}),
            html.Span(tag, style={
                'color': tag_color, 'backgroundColor': tag_color + '22',
                'padding': '1px 6px', 'borderRadius': '3px', 'fontWeight': 'bold',
                'fontSize': '9px', 'flexShrink': '0',
            }),
            html.Span(msg, style={'color': WHITE}),
        ])

    from datetime import timedelta
    base = datetime.now(timezone.utc)
    logs = [
        html.P('LOG DE TELEMETRÍA', style={
            'fontSize': '10px', 'color': MUTED, 'margin': '0 0 8px 0',
            'letterSpacing': '0.5px',
        }),
        fila_log(ahora, 'ALERTA' if alerta_activa else 'INFO',
                 f'MLX90640: {tv}°C — {"umbral superado · transmisión prioritaria" if alerta_activa else "dentro de parámetros"}',
                 RED if alerta_activa else ACCENT),
        fila_log((base - timedelta(seconds=5)).strftime('%H:%M:%S'),
                 'INFO', f'Captura MLX90640 completada · 768 px · {tv}°C máx', ACCENT),
        fila_log((base - timedelta(seconds=10)).strftime('%H:%M:%S'),
                 'OK', f'Paquete #{datos["paquetes_tx"]:04d} transmitido · latencia {lat} s', GREEN),
        fila_log((base - timedelta(seconds=15)).strftime('%H:%M:%S'),
                 'WARN' if rssi < -85 else 'OK',
                 f'RSSI nRF24L01: {rssi} dBm', AMBER if rssi < -85 else GREEN),
        fila_log((base - timedelta(seconds=30)).strftime('%H:%M:%S'),
                 'OK', f'Batería 3S: {bat}% · Balance energético positivo', GREEN),
    ]
    log_panel = html.Div(children=logs)

    # ── Footer de enlace ───────────────────────────────────────────────────
    link_txt = f'● Enlace activo · nRF24L01 · 2.4 GHz · {rssi} dBm'

    return (
        ahora, modo_txt, modo_style,
        card_tv, borde_tv, card_ti, card_bat, card_lat,
        fig_temp, fig_mapa,
        fig_sub, fig_pow,
        balance, panel_alertas, log_panel, link_txt,
    )


